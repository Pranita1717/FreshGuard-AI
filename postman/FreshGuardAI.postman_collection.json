{
  "info": {
    "_postman_id": "freshguard-ai-v1-collection",
    "name": "FreshGuard AI API Collection",
    "description": "Comprehensive REST API test suite for FreshGuard AI Smart Food Expiry & Inventory Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@freshguard.local\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Login - Store Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@freshguard.local\",\n  \"password\": \"Manager@123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Login - Employee",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@freshguard.local\",\n  \"password\": \"Employee@123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"]}
          }
        }
      ]
    },
    {
      "name": "2. Health & Admin",
      "item": [
        {
          "name": "System Health",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"]}
          }
        },
        {
          "name": "Admin Analytics",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/admin/analytics", "host": ["{{baseUrl}}"], "path": ["admin", "analytics"]}
          }
        }
      ]
    },
    {
      "name": "3. Products & Barcode",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"]}
          }
        },
        {
          "name": "Barcode Lookup",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/products/barcode/8901262010014", "host": ["{{baseUrl}}"], "path": ["products", "barcode", "8901262010014"]}
          }
        }
      ]
    },
    {
      "name": "4. Inventory & Restocking",
      "item": [
        {
          "name": "Get Restocking Intelligence",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/inventory/restocking", "host": ["{{baseUrl}}"], "path": ["inventory", "restocking"]}
          }
        },
        {
          "name": "Get Inventory Logs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/inventory/logs", "host": ["{{baseUrl}}"], "path": ["inventory", "logs"]}
          }
        }
      ]
    },
    {
      "name": "5. Discounts & OCR",
      "item": [
        {
          "name": "Get Discount Suggestions",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/discounts/suggestions", "host": ["{{baseUrl}}"], "path": ["discounts", "suggestions"]}
          }
        },
        {
          "name": "Extract Expiry from Text",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"EXPIRY DATE: 29/09/2026 BATCH NO: A451\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/ocr/expiry", "host": ["{{baseUrl}}"], "path": ["ocr", "expiry"]}
          }
        }
      ]
    },
    {
      "name": "6. Reports & PDF",
      "item": [
        {
          "name": "Get Summary Report",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/reports?type=SUMMARY", "host": ["{{baseUrl}}"], "path": ["reports"], "query": [{"key": "type", "value": "SUMMARY"}]}
          }
        },
        {
          "name": "Download PDF Report",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/reports/pdf?type=SUMMARY", "host": ["{{baseUrl}}"], "path": ["reports", "pdf"], "query": [{"key": "type", "value": "SUMMARY"}]}
          }
        }
      ]
    }
  ]
}
